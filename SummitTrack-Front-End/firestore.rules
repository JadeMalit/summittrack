rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDocument(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function ownsTrailPhotoData(uid, trailId) {
      return request.resource.data.uid == uid
        && request.resource.data.trailId == trailId
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches('^trail_photos/' + uid + '/' + trailId + '/[^/]+$');
    }

    function ownsScheduledHikeData(uid) {
      return request.resource.data.ownerUid == uid
        && request.resource.data.userId == uid
        && request.resource.data.id is string
        && request.resource.data.mountainId is string
        && request.resource.data.mountainName is string
        && request.resource.data.trailId is string
        && request.resource.data.trailName is string
        && request.resource.data.hikeDate is timestamp
        && request.resource.data.hikeDateKey is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function ownsDeviceData() {
      return request.resource.data.keys().hasOnly([
          'fcmToken',
          'platform',
          'notificationsEnabled',
          'timezone',
          'appVersion',
          'buildNumber',
          'updatedAt',
        ])
        && request.resource.data.platform is string
        && request.resource.data.notificationsEnabled is bool
        && request.resource.data.timezone is string
        && request.resource.data.appVersion is string
        && request.resource.data.buildNumber is string
        && request.resource.data.updatedAt is timestamp
        && (
          !request.resource.data.keys().hasAny(['fcmToken'])
          || request.resource.data.fcmToken is string
        );
    }

    function ownsNotificationEventData(uid, deviceId) {
      return request.resource.data.keys().hasOnly([
          'eventKey',
          'type',
          'uid',
          'deviceId',
          'hikeId',
          'hikeDateKey',
          'status',
          'source',
          'notificationId',
          'localScheduleConfirmed',
          'claimedUntilMillis',
          'expiresAtMillis',
          'attempts',
          'claimedAt',
          'confirmedAt',
          'displayedAt',
          'updatedAt',
          'errorClass',
        ])
        && request.resource.data.eventKey is string
        && request.resource.data.type == 'scheduled_hike_today'
        && request.resource.data.uid == uid
        && request.resource.data.deviceId == deviceId
        && request.resource.data.hikeId is string
        && request.resource.data.hikeDateKey is string
        && request.resource.data.status in [
          'claiming',
          'scheduled',
          'displayed',
          'retryable',
        ]
        && request.resource.data.source is string
        && request.resource.data.notificationId is int
        && request.resource.data.notificationId > 0
        && request.resource.data.localScheduleConfirmed is bool
        && request.resource.data.claimedUntilMillis is int
        && request.resource.data.expiresAtMillis is int
        && request.resource.data.updatedAt is timestamp
        && (
          !request.resource.data.keys().hasAny(['attempts'])
          || request.resource.data.attempts is int
        )
        && (
          !request.resource.data.keys().hasAny(['claimedAt'])
          || request.resource.data.claimedAt is timestamp
        )
        && (
          !request.resource.data.keys().hasAny(['confirmedAt'])
          || request.resource.data.confirmedAt is timestamp
        )
        && (
          !request.resource.data.keys().hasAny(['displayedAt'])
          || request.resource.data.displayedAt is timestamp
        )
        && (
          !request.resource.data.keys().hasAny(['errorClass'])
          || request.resource.data.errorClass is string
        );
    }

    match /users/{uid} {
      allow read: if ownsUserDocument(uid);
      allow create, update, delete: if ownsUserDocument(uid);

      match /scheduled_hikes/{hikeId} {
        allow read: if ownsUserDocument(uid);
        allow create, update: if ownsUserDocument(uid)
          && ownsScheduledHikeData(uid)
          && request.resource.data.id == hikeId;
        allow delete: if ownsUserDocument(uid);
      }

      match /devices/{deviceId} {
        allow read: if ownsUserDocument(uid);
        allow create, update: if ownsUserDocument(uid) && ownsDeviceData();
        allow delete: if ownsUserDocument(uid);

        match /notificationEvents/{eventId} {
          allow read: if ownsUserDocument(uid);
          allow create, update: if ownsUserDocument(uid)
            && ownsNotificationEventData(uid, deviceId);
          allow delete: if ownsUserDocument(uid);
        }
      }

      match /trail_photos/{trailId}/photos/{photoId} {
        allow read: if ownsUserDocument(uid);
        allow create, update: if ownsUserDocument(uid) && ownsTrailPhotoData(uid, trailId);
        allow delete: if ownsUserDocument(uid);
      }
    }
  }
}
