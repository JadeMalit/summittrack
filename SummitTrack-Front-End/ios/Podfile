```ruby
platform :ios, '15.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(
    File.join('..', 'Flutter', 'Generated.xcconfig'),
    __FILE__
  )

  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. Run flutter pub get first."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end

  raise "FLUTTER_ROOT was not found in #{generated_xcode_build_settings_path}."
end

require File.expand_path(
  File.join('packages', 'flutter_tools', 'bin', 'podhelper'),
  flutter_root
)

flutter_ios_podfile_setup

target 'Runner' do

  # Firebase and other Flutter plugins
  # work better with static frameworks.
  use_frameworks! :linkage => :static

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|

  installer.pods_project.targets.each do |target|

    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|

      # Minimum iOS version
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'

      # Bitcode is no longer required
      config.build_settings['ENABLE_BITCODE'] = 'NO'

      # Prevent CocoaPods targets from trying to sign
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
      config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'

      # Firebase / gRPC compatibility
      config.build_settings[
        'CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'
      ] = 'YES'

      config.build_settings[
        'CLANG_WARN_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'
      ] = 'NO'

      # Prevent warnings from being treated as errors
      config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'

      config.build_settings['SWIFT_TREAT_WARNINGS_AS_ERRORS'] = 'NO'

      # C / C++ flags
      ['OTHER_CFLAGS', 'OTHER_CPLUSPLUSFLAGS'].each do |setting|

        flags = config.build_settings[setting]

        if flags.nil?
          flags = '$(inherited)'
        elsif flags.is_a?(Array)
          flags = flags.join(' ')
        end

        flags = flags.to_s

        # Remove problematic -G flag
        flags = flags.gsub(/(^|\s)-G(\s|$)/, ' ')

        flags = flags.gsub(
          '-GCC_WARN_INHIBIT_ALL_WARNINGS',
          ''
        )

        config.build_settings[setting] =
          "#{flags} -Wno-error=non-modular-include-in-framework-module -Wno-non-modular-include-in-framework-module"
      end
    end
  end

  # ---------------------------------------------------------
  # gRPC-Core compatibility patch
  # ---------------------------------------------------------

  grpc_pod = installer.pods_project.targets.find do |target|
    target.name == 'gRPC-Core'
  end

  if grpc_pod

    grpc_pod.build_configurations.each do |config|

      config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'

      config.build_settings['CLANG_WARN_DOCUMENTATION_COMMENTS'] = 'NO'

      config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'

      config.build_settings[
        'CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'
      ] = 'YES'

      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end

  # ---------------------------------------------------------
  # BoringSSL-GRPC compatibility
  # ---------------------------------------------------------

  boring_ssl = installer.pods_project.targets.find do |target|
    target.name == 'BoringSSL-GRPC'
  end

  if boring_ssl

    boring_ssl.source_build_phase.files.each do |file|

      next unless file.settings
      next unless file.settings['COMPILER_FLAGS']

      flags = file.settings['COMPILER_FLAGS'].split

      flags.reject! do |flag|
        flag == '-GCC_WARN_INHIBIT_ALL_WARNINGS' ||
        flag.start_with?('-G')
      end

      file.settings['COMPILER_FLAGS'] = flags.join(' ')
    end

    boring_ssl.build_configurations.each do |config|

      config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'

      config.build_settings[
        'CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'
      ] = 'YES'

      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end

  # ---------------------------------------------------------
  # Direct gRPC basic_seq.h patch
  # ---------------------------------------------------------

  grpc_header = File.join(
    installer.sandbox.pod_dir('gRPC-Core'),
    'src/core/lib/promise/detail/basic_seq.h'
  )

  if File.exist?(grpc_header)

    puts "Applying gRPC-Core compatibility patch..."

    begin

      content = File.read(grpc_header)

      # Fix:
      # "A template argument list is expected after a name
      # prefixed by the template keyword"

      content = content.gsub(
        'template Poll<',
        'Poll<'
      )

      # Fix template-template parameter syntax
      content = content.gsub(
        'template <template <typename> class F>',
        'template <template <typename...> class F>'
      )

      File.open(grpc_header, 'w') do |file|
        file.write(content)
      end

      puts "gRPC-Core compatibility patch applied successfully."

    rescue => e

      puts "WARNING: Could not patch gRPC-Core:"
      puts e.message

    end
  end

  # ---------------------------------------------------------
  # Runner project settings
  # ---------------------------------------------------------

  installer.aggregate_targets.each do |aggregate_target|

    aggregate_target.user_project.native_targets.each do |target|

      target.build_configurations.each do |config|

        config.build_settings[
          'CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'
        ] = 'YES'

        config.build_settings[
          'CLANG_WARN_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'
        ] = 'NO'

      end
    end
  end

end
```
